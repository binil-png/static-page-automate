# Copy to .env for local use. Never commit real keys.
# On Render: Environment tab. Do not upload .env, credentials.json, or setup.json via Git.
# Optional Render Secret File: create credentials.json, then set
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/credentials.json
# Optional persistent disk: mount it and set DATA_DIR to that path.

PORT=3000
NODE_ENV=production
DATA_DIR=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Paste the full service account JSON as one line, or a base64 of that JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
# On Render Secret Files, use: /etc/secrets/credentials.json

GOOGLE_SHEET_URL=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
GOOGLE_SHEET_GID=
GOOGLE_FORM_URL=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_MAPS_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
